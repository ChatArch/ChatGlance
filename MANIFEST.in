# All deployment documentation in the source distribution must be public.
include docs/quickstart.md
include docs/site-services.md
include docs/site-services.en.md
include docs/infra.md
include docs/cli-tree.md
include docs/codex-reset-policy.md
include docs/reset-controls.md
include mkdocs.yml
recursive-include docs/site *.md
recursive-include examples *.yml
recursive-include scripts *.sh
recursive-include scripts *.py
include scripts/chatglance-from-source
recursive-include src/chatglance/resources *.yml *.conf *.sh *.service *.timer *.json
